{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SilasDownloader",
  "version": "1.3.2",
  "identifier": "site.silas.silasdownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SilasDownloader",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["silasdownloader"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QkE1NTY0Q0E2ODg4NzAKUldSd2lHaktaRlc2RjhSaTNnZjJTQTBHTGtGSm9OaDFTSFlnOTlmK2Zvb3ZNL0g3MFoxaENBcDMK",
      "endpoints": [
        "https://github.com/silasnetwin/silasdownloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Silas",
    "copyright": "© 2026 Silas",
    "shortDescription": "Video- und Audio-Downloader für alle Seiten",
    "longDescription": "SilasDownloader lädt Videos, Playlists und Serien von beliebigen Seiten herunter. yt-dlp, FFmpeg, Deno und aria2c sind bereits enthalten.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/*": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "startMenuFolder": "SilasDownloader",
        "installerHooks": null,
        "minimumWebview2Version": "0.1.0"
      }
    }
  }
}
